<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Images\app.ico</ApplicationIcon>
    <!-- Disable compiled bindings temporarily to avoid InvalidCastException introduced by compiled XAML after the redesign. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>SleepMoodJournal</RootNamespace>
    <!-- Lint: los analizadores de .NET y las reglas de estilo (ver .editorconfig) corren también en cada build. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <!-- UI -->
    <PackageReference Include="Avalonia" Version="11.2.*" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.*" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.*" />
    <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="11.2.*" />

    <!-- MVVM -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.*" />

    <!-- Persistencia -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Gráficos -->
    <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia" Version="2.0.0-rc5.4" />
    <!-- Seguridad: parchea vulnerabilidad en Tmds.DBus.Protocol -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Empaquetar fuentes locales (si existen) para que Avalonia pueda resolverlas como avares:// recursos -->
    <AvaloniaResource Include="Assets\Fonts\**\*.*" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\Images\**\*.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- El proyecto de tests vive dentro de esta carpeta y se excluye del build de la app. -->
    <Compile Remove="SleepMoodJournal.Tests\**\*.cs" />
    <EmbeddedResource Remove="SleepMoodJournal.Tests\**\*" />
    <None Remove="SleepMoodJournal.Tests\**\*" />
  </ItemGroup>

</Project>
